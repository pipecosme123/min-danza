# Vite copia public/ tal cual a dist/, así que este archivo viaja con cada
# build. Ver docs/deployment/cpanel-deployment-plan.md §1.3/§2.

# --- Forzar HTTPS (AutoSSL) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- Fallback SPA: react-router-dom (BrowserRouter, client/src/App.jsx) ---
  # Cualquier ruta que no sea un archivo o directorio real -> index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Caché: assets con hash, inmutables; index.html nunca ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
