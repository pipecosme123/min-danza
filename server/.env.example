# Cadena de conexión de PostgreSQL usada por Prisma.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS?schema=public
# Puerto 5433: el quick-start del README levanta un contenedor Docker
# dedicado a este proyecto en ese puerto, para no chocar con una instalación
# nativa de Postgres que ya pueda estar usando el 5432 por defecto.
DATABASE_URL="postgresql://user:password@localhost:5433/api_ejercicio?schema=public"

# Secreto usado para firmar/verificar los JWT del admin. Genera uno propio y
# largo (nunca reutilices este valor); nunca lo commitees ni lo hardcodees.
JWT_SECRET="replace-with-a-long-random-secret"

# Credenciales del único AdminUser que siembra `prisma/seed.js`.
# ADMIN_PASSWORD es obligatoria: el seed aborta si no está definida (nunca
# hay una contraseña por defecto hardcodeada en el código).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Puerto en el que escucha la API Express.
PORT=4000

# Origen exacto permitido por CORS (la SPA de /client en desarrollo/producción).
# Nunca usar "*" en producción.
CLIENT_ORIGIN="http://localhost:5173"

# Zona horaria usada para TODO cálculo de calendario (último domingo/sábado
# del mes, días de la semana de los turnos fijos). Nunca se usa la zona del
# proceso del servidor para esto.
APP_TIMEZONE="America/Bogota"
